<!DOCTYPE html>
<html>
    <head>
        <title>Weather</title>
        <link rel="icon" href="/img/cloudy.png">
        <link rel="stylesheet" href="./css/styles.css">
    </head>
    <body>
        <div class="main-content">
            {{>header}}
            <p>Use this site to get your weather information!</p>

            <form>
                <input placeholder="Location">
                <button>Search</button>
            </form>

            <p id="error-paragraph" style="color: red"></p>

            <p id="weather-paragraph"></p>
        </div>

        {{>footer}}

        <script src="./js/app.js"></script>
    </body>
</html>